# Clerk — authentication / accounts.
# Find these in your Clerk dashboard: https://dashboard.clerk.com → API keys.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx

# Where Clerk sends users for sign in / sign up (these routes already exist).
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Auth is inert until the two keys above are set, so the site runs fine without
# them. Copy this file to .env.local (git-ignored) once you have real keys.

# Resend — newsletter signups (stores subscribers in a Resend audience).
# Find these at https://resend.com → API Keys and Audiences.
RESEND_API_KEY=re_xxx
RESEND_AUDIENCE_ID=your-audience-id
# Optional: sends a welcome email. Use a verified-domain sender, e.g.
# "Gafar Aleshe <hello@gafaraleshe.com>". Leave unset to skip the email.
RESEND_FROM=

# ─── Instagram auto-feed ──────────────────────────────────────────────────
# The home page pulls the latest posts from the Instagram Graph API
# ("Instagram API with Instagram Login"). Without a token the site still works
# — it shows the branded fallback grid.

# Long-lived Instagram access token (valid 60 days; auto-refreshed monthly by
# the Vercel cron at /api/instagram/refresh). This is the only required value.
IG_ACCESS_TOKEN=

# Secret Vercel sends on cron requests so the refresh endpoint can't be called
# by the public. Set any random string here AND in the Vercel project settings.
CRON_SECRET=

# Optional: connect a (free) Vercel KV store and these are injected
# automatically — the refreshed token is then persisted so it never expires.
# KV_REST_API_URL and KV_REST_API_TOKEN come from the KV integration.
